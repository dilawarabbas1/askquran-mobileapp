# AskQuran public API configuration (read by Expo at build/start via EXPO_PUBLIC_*).
# Copy to `.env` (gitignored) or export in your shell. NEVER commit the real key.

# Your read-only API key (scopes: quran:read, translations:read, tafsir:read, audio:read)
EXPO_PUBLIC_API_KEY=aq_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the base URL (e.g. point at a server-side proxy that holds the key)
# EXPO_PUBLIC_API_BASE_URL=https://api.askquran.co/api/v1
