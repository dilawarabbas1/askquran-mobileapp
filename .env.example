# AskQuran mobile API configuration — read by Expo at build/start via EXPO_PUBLIC_*.
# Copy to `.env` (gitignored) or set as an EAS secret. NEVER commit the real key.

# The mobile app's API key. A portal-issued key (Admin → API Credentials) works
# on BOTH the public /api/* layer (search, suggested questions, translations,
# verses) AND the key-gated /api/v1 layer. Recommended scopes:
#   quran:read, translations:read, tafsir:read, audio:read, questions:read
EXPO_PUBLIC_API_KEY=aq_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Backend HOST ROOT (no trailing /api). The client appends /api and /api/v1.
# Defaults to https://api.askquran.co when unset.
# EXPO_PUBLIC_API_BASE_URL=https://api.askquran.co

# --- xNotify Event Tracking (analytics) ---
# The AskQuran Event Key (a CREDENTIAL — NEVER commit the real value; set it in
# `.env` or as an EAS secret). When unset, analytics is a silent no-op. Events
# are POSTed to <EVENT_API_URL>/v2/save with this key in the x-event-key header.
EXPO_PUBLIC_XNOTIFY_EVENT_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# xNotify EventService host root. Defaults to https://event.xnotify.ai when unset.
# NOTE: use `event.xnotify.ai`, not `api.xnotify.ai` (the latter is a separate API
# gateway that uses x-api-key and rejects the Event Key). Override only to point at
# a staging EventService.
# EXPO_PUBLIC_XNOTIFY_EVENT_API_URL=https://event.xnotify.ai

# --- xNotify Push (react-native-xpush) ---
# Push SDK Key (propertyId) from the portal Configure SDK page (a CREDENTIAL —
# NEVER commit the real value). Passed to Xpush.initialize(subscriberId, propertyId).
# Inert until the push SDK is wired AND Firebase/FCM is configured.
EXPO_PUBLIC_XNOTIFY_PUSH_PROPERTY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
