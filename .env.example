# AskQuran mobile API configuration — read by Expo at build/start via EXPO_PUBLIC_*.
# Copy to `.env` (gitignored) or set as an EAS secret. NEVER commit the real key.

# The mobile app's API key. A portal-issued key (Admin → API Credentials) works
# on BOTH the public /api/* layer (search, suggested questions, translations,
# verses) AND the key-gated /api/v1 layer. Recommended scopes:
#   quran:read, translations:read, tafsir:read, audio:read, questions:read
EXPO_PUBLIC_API_KEY=aq_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Backend HOST ROOT (no trailing /api). The client appends /api and /api/v1.
# Defaults to https://api.askquran.co when unset.
# EXPO_PUBLIC_API_BASE_URL=https://api.askquran.co
