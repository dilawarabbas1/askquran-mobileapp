{
  "name": "askquran-mobileapp",
  "version": "1.0.0",
  "private": true,
  "description": "Ask Quran mobile app — native implementation of the AskQuran mobile design (source-grounded Quran search, no generation). React Native + Expo.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/__tests__/*.test.js\""
  },
  "dependencies": {
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo-google-fonts/noto-nastaliq-urdu": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "expo": "~51.0.28",
    "expo-av": "~14.0.7",
    "expo-font": "~12.0.10",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-svg": "15.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/node": "^20.19.41",
    "@types/react": "~18.2.79",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "~5.3.3"
  }
}
