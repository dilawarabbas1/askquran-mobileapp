{
  "compilerOptions": {
    "strict": true,
    "target": "es2020",
    "lib": ["es2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": ".test-build",
    "noEmit": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": ["src/api/**/*", "src/analytics/**/*", "src/design/lib/uiType.ts", "src/design/lib/__tests__/**/*", "src/notifications/schedulePlan.ts", "src/notifications/__tests__/**/*"],
  "exclude": ["src/api/index.ts", "src/analytics/index.ts"]
}
