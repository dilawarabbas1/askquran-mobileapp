{
  "expo": {
    "name": "Ask Quran",
    "slug": "askquran-mobileapp",
    "version": "1.3.11",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "askquran",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F5D45"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.askquran.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Ask Quran does not use the camera."
      }
    },
    "android": {
      "package": "co.askquran.app",
      "versionCode": 29,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F5D45"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      "expo-asset"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    }
  }
}
